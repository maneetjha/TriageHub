      "keywords": ["love the app", "suggestion", "add new episodes", "narrator voice", "season 2", "more content", "great show", "dark mode", "feature request", "ui improvement"],
      "priority": "LOW",
      "auto_reply_eligible": true,
      "escalation_triggers": []
